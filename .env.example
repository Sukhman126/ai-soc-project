# ---- Telegram Bot ----
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal or group chat ID (message @userinfobot to find yours).
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- Ollama ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Cowrie ----
# Path to cowrie.json as seen from wherever monitor.py runs.
COWRIE_LOG_PATH=./cowrie-data/log/cowrie.json

# How often (seconds) monitor.py checks the log file for new lines.
POLL_INTERVAL=5
